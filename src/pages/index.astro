---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import CallToAction from '../components/CallToAction.astro';
import Timeline from '../components/Timeline.astro';
import Grid from '../components/Grid.astro';
import Project from '../components/Project.astro';
import { type CollectionEntry, getCollection } from 'astro:content';

type Project = CollectionEntry<'projects'>;

const projects = (await getCollection('projects'))
    .sort((a: Project, b: Project) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 4);

// Drop a headshot at src/assets/portrait.(jpg|jpeg|png|webp) and it shows up automatically.
const portraitModules = import.meta.glob<string>('../assets/portrait.{jpg,jpeg,png,webp}', {
    eager: true,
    query: '?url',
    import: 'default'
});
const portrait = Object.values(portraitModules)[0] ?? null;
---

<BaseLayout
    title="Hans Wassermann"
    description="Hans Wassermann is an electrical and computer engineer focused on control systems and embedded software."
>
    <div class="stack gap-20 lg:gap-48">
        <div class="wrapper">
            <header class="hero">
                <div class="hero-text">
                    <Hero
                        title="Hi, I'm Hans Wassermann"
                        tagline="Electrical & computer engineer; control systems, automation, and embedded software"
                        align="start"
                    >
                        <p class="intro">
                            My interests center on IoT, controls, and automation — specifically building reliable systems that sense, adapt, and respond to the world around them.
                        </p>

                        <div class="hero-cta">
                            <CallToAction href="/projects">
                                See Projects
                                <Icon icon="arrow-right" size="1.2em" />
                            </CallToAction>
                        </div>
                    </Hero>
                </div>

                <div class="hero-photo">
                    {
                        portrait ? (
                            <img
                                src={portrait}
                                alt="Portrait of Hans Wassermann"
                                width="480"
                                height="600"
                            />
                        ) : (
                            <div class="photo-placeholder">
                                <span>Add a photo at<br />src/assets/portrait.jpg</span>
                            </div>
                        )
                    }
                </div>
            </header>
        </div>

        <main class="wrapper stack gap-20 lg:gap-48">
            <section class="section">
                <header class="section-header stack gap-2 lg:gap-4">
                    <h3>Experience</h3>
                    <p>Where I've studied and worked.</p>
                </header>
                <div class="section-body">
                    <Timeline />
                </div>
            </section>

            {
                projects.length > 0 && (
                    <section class="section with-cta">
                        <header class="section-header stack gap-2 lg:gap-4">
                            <h3>Recent Projects</h3>
                            <p>A few things I've built recently.</p>
                        </header>

                        <div class="gallery">
                            <Grid variant="offset">
                                {projects.map((project: Project) => (
                                    <li>
                                        <Project project={project} />
                                    </li>
                                ))}
                            </Grid>
                        </div>

                        <div class="cta">
                            <CallToAction href="/projects">
                                View All
                                <Icon icon="arrow-right" size="1.2em" />
                            </CallToAction>
                        </div>
                    </section>
                )
            }
        </main>
    </div>
</BaseLayout>

<style>
    .hero {
        display: flex;
        flex-direction: column-reverse;
        align-items: center;
        gap: 2rem;
        padding-top: 1rem;
    }

    .intro {
        margin-top: 1rem;
        max-width: 48ch;
        color: var(--gray-300);
        font-size: var(--text-md);
    }

    .hero-cta {
        margin-top: 1.5rem;
        display: flex;
    }

    .hero-photo {
        width: min(100%, 22rem);
    }

    .hero-photo img,
    .photo-placeholder {
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        object-position: top;
        border-radius: 1.5rem;
        box-shadow: var(--shadow-md);
    }

    .photo-placeholder {
        display: grid;
        place-items: center;
        text-align: center;
        padding: 1rem;
        color: var(--gray-400);
        font-size: var(--text-sm);
        border: 1px dashed var(--gray-700);
        background: var(--gradient-subtle);
    }

    .section {
        display: grid;
        gap: 2rem;
    }

    .section-header {
        max-width: 50ch;
        font-size: var(--text-md);
        color: var(--gray-300);
    }

    .section-header h3 {
        font-size: var(--text-2xl);
        color: var(--gray-100);
    }

    @media (min-width: 50em) {
        .hero {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 3.75rem;
            padding-block: 1rem 2rem;
            padding-inline: 2.5rem;
        }

        .hero-text {
            flex: 1 1 auto;
        }

        .hero-photo {
            flex: 0 0 auto;
            width: min(38%, 24rem);
        }

        .hero-photo img,
        .photo-placeholder {
            aspect-ratio: 3 / 4;
            border-radius: 2rem;
        }

        .section {
            grid-template-columns: repeat(4, 1fr);
            grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
            gap: 3rem 5rem;
        }

        .section.with-cta {
            grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
        }

        .section-header {
            grid-area: header;
            font-size: var(--text-lg);
        }

        .section-header h3 {
            font-size: var(--text-4xl);
        }

        .section-body {
            grid-area: gallery;
        }

        .gallery {
            grid-area: gallery;
        }

        .cta {
            grid-area: cta;
            justify-self: flex-end;
        }
    }
</style>
