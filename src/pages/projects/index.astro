---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Grid from '../../components/Grid.astro';
import Project from '../../components/Project.astro';
import { type CollectionEntry, getCollection } from 'astro:content';

type Project = CollectionEntry<'projects'>;

const projects = (await getCollection('projects'))
    .sort((a: Project, b: Project) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
    title="Projects | Hans Wassermann"
    description="Projects by Hans Wassermann across control systems, embedded software, robotics, and machine learning."
    image={projects[0]?.data.image?.path}
    imageAlt={projects[0]?.data.image?.alt}
>
    <div class="stack gap-20">
        <main class="wrapper stack gap-8">
            <Hero
                title="Projects"
                tagline="Things I've designed and built, in and out of coursework."
                align="start"
            />
            {
                projects.length > 0 ? (
                    <Grid variant="offset">
                        {projects.map((project: Project) => (
                            <li>
                                <Project project={project} />
                            </li>
                        ))}
                    </Grid>
                ) : (
                    <p>No projects yet — check back soon.</p>
                )
            }
        </main>
    </div>
</BaseLayout>
