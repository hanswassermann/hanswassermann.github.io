---
import '../styles/global.css';
import { getSchema } from "../utils/schema";

interface Props {
    title: string;
    description: string;
    image?: string;
    imageAlt?: string;
    noindex?: boolean;
    canonical?: string;
    markdown?: string;
}

const { title, description, image, imageAlt, noindex, canonical, markdown } = Astro.props;

const imagePath = image ? new URL(image, Astro.site).href : null;

const url = new URL(Astro.url.pathname, Astro.site).href;

const schema = getSchema({
    title,
    description,
    site: Astro.site?.origin ?? Astro.url.origin,
    pathname: Astro.url.pathname
});

const jsonLdString = JSON.stringify(schema);

// Cloudflare Web Analytics: accept either a bare token or the full <script> snippet
// pasted from the Cloudflare dashboard — pull the 32-char hex token out either way.
const cfBeaconToken = (import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? '').match(/[a-f0-9]{32}/i)?.[0] ?? '';
---

<!-- Essential Elements -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Basic Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="application-name" content="Hans Wassermann" />
<meta name="author" content="Hans Wassermann" />
<link rel="canonical" href={canonical ?? url} />
{ noindex && <meta name="robots" content="noindex" /> }

<!-- Favicon -->
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Hans Wassermann" />
<link rel="manifest" href="/manifest.json" />

<!-- Theme Color -->
<meta name="theme-color" content="#7611a6" />
<meta name="color-scheme" content="only light" />

<!-- Software Attribution -->
<meta name="generator" content={Astro.generator} />

<!-- OpenGraph Metadata -->
<meta property="og:url" content={url} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Hans Wassermann" />
<meta property="og:locale" content="en_US" />
{ imagePath && <meta property="og:image" content={imagePath} /> }
{ imageAlt && <meta property="og:image:alt" content={imageAlt} /> }

<!-- Twitter Cards -->
<meta name="twitter:card" content={imagePath ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ imagePath && <meta name="twitter:image" content={imagePath} /> }

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />
{ markdown && <link rel="alternate" type="text/markdown" title="LLM-friendly version" href={markdown} /> }

<!-- Preloading -->
<link rel="preload" href="/fonts/rubik-600.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/public-sans-400.woff2" as="font" type="font/woff2" crossorigin />

<!-- JSON-LD Schema -->
<script type="application/ld+json" set:html={jsonLdString} />

<!-- Cloudflare Web Analytics (set PUBLIC_CF_BEACON_TOKEN in the build env once the site is added in Cloudflare) -->
{
    import.meta.env.PROD && cfBeaconToken && (
        <script
            is:inline
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
        />
    )
}