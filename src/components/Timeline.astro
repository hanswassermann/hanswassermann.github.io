---
import { experience, type TimelineEntry } from '../data/experience';

const formatDate = (value: string) => {
    if (value.toLowerCase() === 'present') return 'Present';
    const [year, month] = value.split('-').map(Number);
    return new Date(year, (month ?? 1) - 1).toLocaleDateString('en-US', {
        month: 'short',
        year: 'numeric'
    });
};

const STOPWORDS = new Set(['of', 'the', 'and', 'for', 'at', '&', '-', '—']);

const initials = (name: string) =>
    name
        .split(/\s+/)
        .filter((word) => !STOPWORDS.has(word.toLowerCase()))
        .slice(0, 2)
        .map((word) => word[0]?.toUpperCase() ?? '')
        .join('');

const entries = [...experience].sort((a, b) => b.start.localeCompare(a.start));
---

<ol class="timeline">
    {
        entries.map((entry: TimelineEntry) => (
            <li class="entry" data-type={entry.type}>
                <div class="node">
                    <span class="badge">
                        {entry.logo ? (
                            <img src={entry.logo} alt={`${entry.org} logo`} loading="lazy" />
                        ) : (
                            <span class="initials">{initials(entry.org)}</span>
                        )}
                    </span>
                </div>

                <article class="card">
                    <p class="meta">
                        <span class="kind">{entry.type === 'education' ? 'Education' : 'Experience'}</span>
                        <span class="period">
                            {formatDate(entry.start)} &ndash; {formatDate(entry.end)}
                        </span>
                    </p>
                    <h3 class="role">{entry.title}</h3>
                    <p class="org">
                        {entry.org}
                        {entry.location && <span class="location"> &middot; {entry.location}</span>}
                    </p>
                    {entry.description && <p class="description">{entry.description}</p>}
                    {entry.points && entry.points.length > 0 && (
                        <ul class="points">
                            {entry.points.map((point: string) => (
                                <li>{point}</li>
                            ))}
                        </ul>
                    )}
                </article>
            </li>
        ))
    }
</ol>

<style>
    .timeline {
        --spine: 1.75rem;
        --badge-size: 3.75rem;
        position: relative;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* The vertical spine. */
    .timeline::before {
        content: '';
        position: absolute;
        top: 0.25rem;
        bottom: 0.25rem;
        left: var(--spine);
        width: 2px;
        background: var(--gray-800);
    }

    .entry {
        position: relative;
        padding-left: calc(var(--spine) + var(--badge-size) / 2 + 1.9rem);
        margin-bottom: 2.5rem;
    }

    .entry:last-child {
        margin-bottom: 0;
    }

    /* Node + badge sitting on the spine. */
    .node {
        position: absolute;
        left: var(--spine);
        top: calc(1.5rem - var(--badge-size) / 2);
        transform: translateX(-50%);
        z-index: 1;
    }

    .badge {
        display: grid;
        place-items: center;
        width: var(--badge-size);
        height: var(--badge-size);
        border-radius: 999rem;
        background: var(--gray-999);
        border: 2px solid var(--accent-color, var(--gray-400));
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .badge img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 0.4rem;
    }

    .initials {
        font-family: var(--font-brand);
        font-size: var(--text-sm);
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--accent-color, var(--gray-400));
    }

    /* Connector from the spine to the card. */
    .card::before {
        content: '';
        position: absolute;
        top: 1.5rem;
        left: calc(var(--spine) + var(--badge-size) / 2);
        width: 1.9rem;
        height: 2px;
        background: var(--gray-800);
    }

    .card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        padding: 1.1rem 1.35rem;
        border: 1px solid var(--gray-800);
        border-top: 3px solid var(--accent-color, var(--gray-400));
        border-radius: 0.85rem;
        background: var(--gray-999_40);
        box-shadow: var(--shadow-sm);
    }

    .entry[data-type='work'] {
        --accent-color: var(--accent-regular);
    }

    .entry[data-type='education'] {
        --accent-color: var(--gray-400);
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-brand);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .kind {
        padding: 0.15rem 0.55rem;
        border-radius: 999rem;
        color: var(--accent-text-over);
        background: var(--accent-color, var(--gray-400));
    }

    .period {
        color: var(--gray-400);
    }

    .role {
        font-size: var(--text-lg);
        color: var(--gray-100);
    }

    .org {
        color: var(--gray-300);
    }

    .location {
        color: var(--gray-400);
    }

    .description {
        margin-top: 0.35rem;
        color: var(--gray-300);
    }

    .points {
        margin: 0.5rem 0 0;
        padding-left: 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        color: var(--gray-300);
    }

    /* Two-sided layout: education on the left, work on the right. */
    @media (min-width: 50em) {
        .timeline {
            --badge-size: 4.75rem;
        }

        .timeline::before {
            left: 50%;
            transform: translateX(-50%);
        }

        .entry {
            display: grid;
            grid-template-columns: 1fr 1fr;
            column-gap: 7rem;
            padding-left: 0;
            margin-bottom: 3.25rem;
        }

        .node {
            left: 50%;
        }

        .initials {
            font-size: var(--text-base);
        }

        .card {
            max-width: 34rem;
        }

        .entry[data-type='education'] .card {
            grid-column: 1;
            margin-left: auto;
            text-align: right;
            align-items: flex-end;
        }

        .entry[data-type='work'] .card {
            grid-column: 2;
            margin-right: auto;
        }

        .entry[data-type='education'] .points {
            /* keep bullet lists readable even when the card is right-aligned */
            text-align: left;
        }

        .entry[data-type='work'] .card::before {
            left: calc(-1 * (3.5rem - var(--badge-size) / 2));
            width: calc(3.5rem - var(--badge-size) / 2);
        }

        .entry[data-type='education'] .card::before {
            left: auto;
            right: calc(-1 * (3.5rem - var(--badge-size) / 2));
            width: calc(3.5rem - var(--badge-size) / 2);
        }
    }
</style>
