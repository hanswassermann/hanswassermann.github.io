---
import '../styles/markdown.css';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Comments from '../components/Comments.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout
    title={`${frontmatter.title} | Max Parisi`}
    description={frontmatter.description}
    image={frontmatter.image?.path}
    imageAlt={frontmatter.image?.alt}
    noindex={frontmatter.noindex}
>
    <div class="stack gap-15">
        <header>
            <div class="wrapper stack gap-2">
                <Hero
                    title={frontmatter.title}
                    tagline={frontmatter.description}
                />
            </div>
        </header>
        
        <main class="wrapper">
            <div class="stack gap-10 content">
                { frontmatter.image && <img src={frontmatter.image.path} alt={frontmatter.image.alt || ''} /> }
                <div class="markdown">
                    <slot />
                </div>
            </div>
        </main>

        { frontmatter.comments !== false && (
            <section class="wrapper comments">
                <Comments />
            </section>
        )}
    </div>
</BaseLayout>

<style>
    .content {
        max-width: 65ch;
        margin-inline: auto;
    }

    .content > img {
        margin-bottom: 1rem;
    }
</style>